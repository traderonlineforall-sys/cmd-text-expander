            "uuid": "{da47d286-e829-41e5-923c-75464d09455e}"
        },
        {
            "caseSensitivity": 0,
            "creationDateTime": "2025-06-18T23:43:51.406",
            "description": "",
            "enabled": true,
            "group": "{229305c6-8631-4706-8aae-1357b61a7c76}",
            "keyword": "تبين",
            "matchingMode": 0,
            "modificationDateTime": "2025-06-18T23:44:09.620",
            "name": "",
            "snippet": "حضرتك بعد المتابعة، تبين إن البطء اللي بتواجهه ناتج عن ضغط عالي على سيرفرات بعض المواقع الأخرى اللي بتحاول تدخل عليها حاليًا، وده بيأثر على سرعة التحميل بشكل عام، لكن الخدمة من جانبنا مستقرة ومفيش أي مشكلة على الخط نفسه.\nأنصح حضرتك بتجربة الموقع في وقت لاحق، وهتلاحظ تحسن واضح بإذن الله\n",
            "uuid": "{950ebcce-cdce-46b8-8f78-4445461e2644}"
        },
        {
            "caseSensitivity": 0,
            "creationDateTime": "2025-06-19T02:26:45.728",
            "description": "",
            "enabled": true,
            "group": "{229305c6-8631-4706-8aae-1357b61a7c76}",
            "keyword": "عر",
            "matchingMode": 0,
            "modificationDateTime": "2025-06-19T02:27:28.967",
            "name": "",
            "snippet": "لكن حابب أطمن حضرتك إننا بنراجع العروض والخطط باستمرار، ولو اتوفر أي عرض مناسب لحضرتك الفترة الجاية إن شاء الله، هيوصلك فورا عن طريق رسالة أو حد هيتصل بحضرتك او برجاء متابعة موقعنا الالكتروني وصفحاتنا الرسمية علي مواقع التواصل الاجتماعي لمعرفة العروض الجديدة\n",
            "uuid": "{c999bf49-a8b8-4412-a0f2-2bb62c4a5c70}"
        },
        {
            "caseSensitivity": 0,
            "creationDateTime": "2025-06-21T23:32:26.092",
            "description": "",
            "enabled": true,
            "group": "{082196d3-4f4f-4eea-a4d8-02df6e64992f}",
            "keyword": "كنت",
            "matchingMode": 0,
            "modificationDateTime": "2025-06-21T23:32:29.618",
            "name": "",
            "snippet": "تمام للاسف لو مش متوفر جهاز متوصل عن طريق كابل مش هنقدر نكمل الخطوات يفندم وحضرتك لو مشكلة البطىء استمرت معاك ممكن تتابع معانا لما يكون فى امكانيه تكمل الخطوات عشان نعرف نساعدك\n",
            "uuid": "{77e26d6a-2c2f-4420-8981-116a2d966b15}"
        },
        {
            "caseSensitivity": 0,
            "creationDateTime": "2025-06-24T14:43:46.016",
            "description": "",
            "enabled": true,
            "group": "{082196d3-4f4f-4eea-a4d8-02df6e64992f}",
            "keyword": "ادب",
            "matchingMode": 0,
            "modificationDateTime": "2025-06-24T14:43:50.388",
            "name": "",
            "snippet": "تمام كده الراوتر مش واصل ليه كهربا هل حضرتك بتجرب من الادابتور الاصلى الشاحن ال جاى مع الراوتر الاصلى؟\n",
            "uuid": "{daa9a0bb-7806-4585-8ca3-eca05aca5b2c}"
        },
        {
            "caseSensitivity": 0,
            "creationDateTime": "2025-06-24T15:44:22.354",
            "description": "",
            "enabled": true,
            "group": "{082196d3-4f4f-4eea-a4d8-02df6e64992f}",
            "keyword": "جنب",
            "matchingMode": 0,
            "modificationDateTime": "2025-06-24T15:44:26.136",
            "name": "",
            "snippet": "ممكن تقرب من الراوتر للتاكد عشان لو بتوضح غلط هنتابع خطوات مشكله غلط والمفروض متكونش منوره بناء على الموضح ليا\n",
            "uuid": "{93f74d6c-477e-42e9-a2f2-417a1a04101c}"
        },
        {
            "caseSensitivity": 0,
            "creationDateTime": "2025-06-24T16:50:38.897",
            "description": "",
            "enabled": true,
            "group": "{082196d3-4f4f-4eea-a4d8-02df6e64992f}",
            "keyword": "شح",
            "matchingMode": 0,
            "modificationDateTime": "2025-06-24T16:50:54.083",
            "name": "",
            "snippet": "للاسف شحن الكروت من خلالنا مش متاح الا لو كلمتنا من نفس الحساب فقط\nتقدر تشحن الكروت من الخدمه الصوتيه كوسيله اسهل ايضا",
            "uuid": "{e3c2dffa-ea00-4ae2-88b1-cc1b160f9a1a}"
        },
        {
            "caseSensitivity": 0,
            "creationDateTime": "2025-06-24T17:38:27.550",
            "description": "",
            "enabled": true,
            "group": "{082196d3-4f4f-4eea-a4d8-02df6e64992f}",
            "keyword": "اب",
            "matchingMode": 0,
            "modificationDateTime": "2025-06-24T17:39:06.233",
            "name": "",
            "snippet": "حضرتك علشان تبدأ تفعيل الحساب لأول مرة على تطبيق My WE، هاتتبع الخطوات البسيطة دي:\n\n1️⃣ هتدخل كود المحافظة ورقم الخط الأرضي الخاص بخدمة الإنترنت وبعد كده اضغط على \"التالي\".\n\n2️⃣ هيظهرلك خانتين تدخل فيهم الرقم السري مرتين، وهتوافق على الشروط والأحكام المقدمة من WE.\n\n3️⃣ هتستلم رسالة فيها كود التفعيل، وعلشان تأمن بياناتك، هيظهرلك أول ٣ أرقام وآخر رقمين من رقم الموبايل اللي اتبعتله الكود.\n\n📩 لو الكود موصلش، تقدر تطلب بسهولة إعادة إرسال كود التفعيل.\n\n4️⃣ بعد استلام الكود، هتدخله في مكانه، وتوافق تاني على الشروط والأحكام.\n\n5️⃣ بعد إدخال البيانات، هتدخل على صفحة مراجعة البيانات، ولو كل حاجة تمام اضغط على \"موافق\".\n\n✅ بعدها هيوصلك رسالة تأكيد بنجاح التسجيل وإن الحساب الخاص بحضرتك بقى جاهز للاستخدام.\n\nلو فيه أي حاجة مش واضحة، أنا تحت أمرك في أي وقت 😊💚\n\n",
            "uuid": "{46fb7aa5-9637-4d2a-a650-a0bad25fea31}"
        },
        {
            "caseSensitivity": 0,
            "creationDateTime": "2025-06-24T18:15:38.355",
            "description": "",
            "enabled": true,
            "group": "{082196d3-4f4f-4eea-a4d8-02df6e64992f}",
            "keyword": "لائق",
            "matchingMode": 0,
            "modificationDateTime": "2025-06-24T18:16:39.940",
            "name": "",
            "snippet": "أنا بعتذرلك جدًا يا فندم عن أي تعامل مكانش لائق حصل من أي موظف، وصدقني إحنا في WE بنهتم جدًا برضا حضرتك وبنعتبر رأيك محل اهتمام كبير.\n\n🎯 لو حضرتك حابب، أقدر أعمل شكوى رسمية بخصوص اللي حصل، وهيتم متابعة الموضوع بكل جدية من الإدارة المختصة، وهنرجعلك بالتفاصيل بعد ما يتم التحقيق فيه.\n\nوفي كل الأحوال، أنا هنا علشان أساعدك في أي استفسار أو طلب،🌟 هدفنا إنك تكون راضي وسعيد بخدمتك معانا، وحضرتك تستحق الأفضل دايمًا.\n\n",
            "uuid": "{5da368a6-a5f9-46f2-9717-e3f607fbc55f}"
        },
        {
            "caseSensitivity": 0,
            "creationDateTime": "2025-06-24T22:39:39.488",
            "description": "",
            "enabled": true,
            "group": "{082196d3-4f4f-4eea-a4d8-02df6e64992f}",
            "keyword": "اب.",
            "matchingMode": 0,
            "modificationDateTime": "2025-06-24T22:39:45.209",
            "name": "",
            "snippet": "حضرتك تقدر تسجل على تطبيق My WE بكل سهولة من خلال الخطوات دي:\n\n🔹 خطوات التسجيل:\n\nافتح تطبيق My WE من على موبايلك.\n\nاضغط على زر \"إنشاء حساب\".\n\nدخل رقم الخدمة سواء كان رقم الموبايل أو رقم الإنترنت الأرضي.\n\nاضغط \"متابعة\".\n\nاختار كلمة سر وادخلها مرتين (لازم تكون ٨ حروف أو أكتر وتكون متطابقة).\n\nوافق على الشروط والأحكام الخاصة بـ WE.\n\nاضغط \"التالي\".\n\nهيوصلك كود تفعيل في رسالة على الموبايل.\n\nدخل كود التفعيل في المكان المخصص.\n\nتقدر توصل حسابك بالسوشيال ميديا أو تضغط \"ابدأ\" علشان تبدأ تستخدم مزايا التطبيق.\n\n🔹 تسجيل الدخول:\nلو حضرتك مسجل قبل كده، تقدر تضغط على \"ابدأ\" علشان تدخل على صفحة تسجيل الدخول:\n\nدخل رقم الخدمة (سواء موبايل أو إنترنت أرضي) وكلمة السر.\n\nاضغط \"تسجيل الدخول\".\n\nهيتم تحويلك للصفحة الرئيسية للتطبيق وتقدر تستمتع بالخدمات.\n\nلو احتجت أي مساعدة خلال التسجيل أو الدخول، أنا تحت أمرك في أي وقت 🌟\n\n",
            "uuid": "{65c821e3-4a80-4a16-a646-bef736238690}"
        },
        {
            "caseSensitivity": 0,
            "creationDateTime": "2025-06-25T19:00:10.912",
            "description": "",
            "enabled": true,
            "group": "{082196d3-4f4f-4eea-a4d8-02df6e64992f}",
            "keyword": "لايف",
            "matchingMode": 0,
