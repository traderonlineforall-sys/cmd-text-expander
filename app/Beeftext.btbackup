            "enabled": true,
            "group": "{082196d3-4f4f-4eea-a4d8-02df6e64992f}",
            "keyword": "ستريم",
            "matchingMode": 0,
            "modificationDateTime": "2025-11-15T00:17:10.382",
            "name": "",
            "snippet": "باقة ستريمزر السرعة بتوصل عليها حتى 80 ميجا وسعر الباقة 684 جنية شاملة الضريبة والباقة بتوصل فيها اللى 500 جيجا متقسمة اللى ( 200 جيجا للاستخدام الاساسى و للاستريمنج 150 جيجا هاتصل الى 300 جيجا ) الابلود 25 ميجا وعند انتهاء الباقة السرعة هاتنزل ال 256 كيلو بايت<br>\n+التطبيقات دى مجانا بدون اى جيجات من باقتك Microsoft teams - Zoom - Google meet - Soundcloud - Deezer - Anghami - Spotify مجانا...",
            "uuid": "{fdd743e5-d27c-4402-9526-ad5c276c762e}"
