            "enabled": true,
            "group": "{229305c6-8631-4706-8aae-1357b61a7c76}",
            "keyword": "حساب",
            "matchingMode": 0,
            "modificationDateTime": "2024-12-08T01:06:11.896",
            "name": "",
            "snippet": "بتضغط على انشاء حساب وتكتب الرقم الارضى كامل وتختار امامه كلمة انترنت وتكمل الخطوات عن طريق اضافة كلمة السر مرتين ولما يوصل الكود على رقم الموبايل المسجل بتكتبه فى التطبيق وتعمل انهاء للخطوات وكده مبروك عليك الحساب بيكون اتعمل يفندم\n",
