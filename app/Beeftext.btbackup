            "enabled": true,
            "group": "{082196d3-4f4f-4eea-a4d8-02df6e64992f}",
            "keyword": "سبب.",
            "matchingMode": 0,
            "modificationDateTime": "2025-11-12T20:09:49.231",
            "name": "",
            "snippet": "اكيد مش سبب بس السرعه كامله ومفيش اعطال بناء فحص السيستم وعشان نعرف سبب البطىء معاك الان يفندم واذاى نحل المشكله محتاجين نتابع الخطوات من جهاز فقط متصل بالراوتر يفندم\n",
            "uuid": "{dc1f12b0-fd38-4c85-a592-db4eff394a9c}"
        },
        {
            "caseSensitivity": 0,
            "creationDateTime": "2025-11-15T00:16:57.742",
