#include <windows.h>

#define IDI_APPICON 101
#define IDR_MANIFEST 1

IDR_MANIFEST RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,3,0,0
 PRODUCTVERSION 1,3,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "cmd Productivity Tools"
            VALUE "FileDescription", "cmd Text Expander - Portable Windows productivity software"
            VALUE "FileVersion", "1.3.0.0"
            VALUE "InternalName", "cmdTextExpander"
            VALUE "OriginalFilename", "cmdTextExpander.exe"
            VALUE "ProductName", "cmd Text Expander"
            VALUE "ProductVersion", "1.3.0.0"
            VALUE "LegalCopyright", "Copyright cmd Productivity Tools"
            VALUE "Comments", "Portable text expansion utility for Windows"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
